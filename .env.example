# API Configuration
# Set your backend microservice URL here
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# NEXT_PUBLIC_API_BASE_URL=https://issue-tracker-newop.duckdns.org/api

# Request timeout in milliseconds (optional, defaults to 30000)
NEXT_PUBLIC_API_TIMEOUT=30000

# Token storage key (optional, defaults to auth_token)
NEXT_PUBLIC_TOKEN_KEY=auth_token
